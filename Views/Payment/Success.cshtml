@model Order
@{
    ViewData["Title"] = "Payment successful";
}
<div class="success-hero">
    <div class="success-check"><i class="bi bi-check-lg"></i></div>
    <h1 class="serif">Payment successful</h1>
    <p style="color:var(--muted);">Order <strong>#@Model.Id</strong> is confirmed and being processed.</p>
    <div class="ref-chip">@Model.PaymentReference</div>
    <div class="d-flex gap-2 justify-content-center">
        <a asp-controller="Orders" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-ink"><i class="bi bi-receipt"></i> View my order</a>
        <a asp-controller="Products" asp-action="Index" class="btn btn-lime">Continue shopping</a>
    </div>
</div>
