@{
    int cartCount = 0;
    var cartJson = Context.Session.GetString("ShoppingCart");
    if (!string.IsNullOrEmpty(cartJson))
    {
        try { cartCount = System.Text.Json.JsonSerializer.Deserialize<List<ShoppingApp.Models.CartItem>>(cartJson)?.Sum(c => c.Quantity) ?? 0; }
        catch { }
    }
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - ShopApp</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

<div class="announce">
    <div class="announce-track">
        <span>Free shipping on all orders</span><span>New drops every Friday</span><span>Secure mock checkout</span><span>30-day returns</span>
        <span>Free shipping on all orders</span><span>New drops every Friday</span><span>Secure mock checkout</span><span>30-day returns</span>
    </div>
</div>

<header class="navb">
    <div class="container navb-inner">
        <a class="wordmark" asp-controller="Products" asp-action="Index">Shop<em>App</em><span class="dot">.</span></a>
        <nav class="nav-links">
            <a asp-controller="Products" asp-action="Index">Shop</a>
            @if (role == "Client")
            {
                <a asp-controller="Cart" asp-action="Index">Cart @if (cartCount > 0) { <span class="cart-badge">@cartCount</span> }</a>
                <a asp-controller="Orders" asp-action="Index">My Orders</a>
            }
            @if (role == "Admin")
            {
                <a asp-controller="AdminProducts" asp-action="Index">Products</a>
                <a asp-controller="AdminOrders" asp-action="Index">Orders</a>
            }
        </nav>
        <div class="ms-auto d-flex align-items-center gap-3">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <span class="user-chip d-none d-md-flex">
                    <i class="bi bi-person-circle"></i> @User.Identity.Name
                    <span class="role-pill">@role</span>
                </span>
                <a class="btn btn-ghost btn-sm" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right"></i> Logout</a>
            }
            else
            {
                <a class="btn btn-ghost btn-sm" asp-controller="Account" asp-action="Login">Login</a>
                <a class="btn btn-ink btn-sm" asp-controller="Account" asp-action="Register">Sign up</a>
            }
        </div>
    </div>
</header>

<main class="container">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @RenderBody()
</main>

<footer class="site">
    <div class="container footer-inner">
        <div class="footer-grid">
            <div>
                <div class="footer-wordmark">ShopApp.</div>
                <p style="max-width:320px;font-size:.9rem;line-height:1.7;margin-top:1rem;">
                    A demo storefront built with ASP.NET Core MVC and MySQL. Browse, buy, and manage — all with a mock payment gateway.
                </p>
            </div>
            <div>
                <h6>Shop</h6>
                <a asp-controller="Products" asp-action="Index">All products</a>
                <a asp-controller="Cart" asp-action="Index">Cart</a>
                <a asp-controller="Orders" asp-action="Index">My orders</a>
            </div>
            <div>
                <h6>Account</h6>
                <a asp-controller="Account" asp-action="Login">Login</a>
                <a asp-controller="Account" asp-action="Register">Sign up</a>
                @if (role == "Admin")
                {
                    <a asp-controller="AdminProducts" asp-action="Index">Admin panel</a>
                }
            </div>
        </div>
        <div class="footer-bottom">
            <span>&copy; 2026 ShopApp — demo project</span>
            <span>ASP.NET Core MVC &middot; MySQL &middot; MockPay</span>
        </div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
