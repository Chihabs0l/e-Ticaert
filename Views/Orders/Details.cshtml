@model Order
@{
    ViewData["Title"] = $"Order #{Model.Id}";
}
<div class="admin-bar">
    <h3>Order <span style="color:var(--brand-2);">#@Model.Id</span></h3>
    <span class="st st-@((int)Model.Status)">@Model.Status</span>
</div>

<div class="meta-grid">
    <div class="meta-card">
        <h5>Order info</h5>
        <p><i class="bi bi-calendar3"></i> @Model.CreatedAt.ToString("MMMM dd, yyyy &middot; HH:mm")</p>
        <p><i class="bi bi-credit-card"></i> @(Model.PaymentReference ?? "Awaiting payment")</p>
    </div>
    <div class="meta-card">
        <h5>Timeline</h5>
        <p>@(Model.Status == OrderStatus.PendingPayment ? "Waiting for payment — complete it from checkout." : $"Current status: {Model.Status}")</p>
    </div>
</div>

<div class="panel">
    <table class="tbl">
        <thead><tr><th>Product</th><th class="num">Unit price</th><th class="text-center">Qty</th><th class="num">Subtotal</th></tr></thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.ProductName</td>
                <td class="num">@item.UnitPrice.ToString("C")</td>
                <td class="text-center"><span class="qty-pill">&times;@item.Quantity</span></td>
                <td class="num">@((item.UnitPrice * item.Quantity).ToString("C"))</td>
            </tr>
        }
        </tbody>
        <tfoot>
            <tr><td colspan="3">Total</td><td class="num" style="color:var(--brand-2);font-size:1.05rem;">@Model.Total.ToString("C")</td></tr>
        </tfoot>
    </table>
</div>
<p class="mt-4"><a asp-action="Index" class="btn btn-ghost btn-sm"><i class="bi bi-arrow-left"></i> All my orders</a></p>
