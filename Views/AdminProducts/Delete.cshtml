@model Product
@{
    ViewData["Title"] = "Delete Product";
}
<div class="panel" style="max-width:560px;margin:3rem auto;border-color:#f0b9b3;">
    <div class="panel-body text-center">
        <i class="bi bi-exclamation-triangle" style="font-size:2.4rem;color:var(--danger);"></i>
        <h3 class="serif mt-3">Delete this product?</h3>
        <p style="color:var(--muted);"><strong>@Model.Name</strong><br />@Model.Price.ToString("C") &middot; @Model.Stock in stock</p>
        <form asp-action="Delete" method="post" class="d-flex gap-2 justify-content-center mt-4">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <button class="btn btn-danger"><i class="bi bi-trash3"></i> Yes, delete it</button>
            <a asp-action="Index" class="btn btn-ghost">Keep it</a>
        </form>
    </div>
</div>
